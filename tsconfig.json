{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "outDir": "./dist/types",
    "baseUrl": ".",
    "paths": {
      "@xinchuan/content": ["packages/content"],
      "@xinchuan/types": ["packages/types"],
      "@xinchuan/utils": ["packages/utils"]
    }
  },
  "include": ["packages/types/**/*"],
  "exclude": ["node_modules", "dist", "apps"]
}
